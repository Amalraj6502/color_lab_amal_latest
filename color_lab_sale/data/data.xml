            <field name="type">normal</field>
            <field name="section">1</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_window_cut_users'))]"></field>

        </record>
        <record id="lamination_pin_normal" model="work.category">
            <field name="step_count">4</field>
            <field name="previous_step" ref="color_lab_sale.window_cut_normal"/>
