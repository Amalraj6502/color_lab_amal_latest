<odoo>
    <data>
        <!--NORMAL FLOW STARTS-->
        <record id="correction_normal" model="work.category">
            <field name="step_count">1</field>
            <field name="name">Correction</field>
            <field name="type">normal</field>
            <field name="section">1</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_correction_users'))]"></field>
            <field name="is_step_bypass">1</field>
        </record>
        <record id="board_normal" model="work.category">
            <field name="step_count">1</field>
            <field name="name">Board</field>
            <field name="type">normal</field>
            <field name="section">2</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_board_users'))]"></field>

        </record>
        <record id="cover_print_normal" model="work.category">
            <field name="step_count">1</field>
            <field name="name">Cover Print</field>
            <field name="type">normal</field>
            <field name="section">3</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_cover_print_users'))]"></field>

        </record>

        <record id="printing_normal" model="work.category">
            <field name="step_count">2</field>
            <field name="previous_step" ref="color_lab_sale.correction_normal"/>
            <field name="name">Printing</field>
            <field name="type">normal</field>
            <field name="section">1</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_printing_users'))]"></field>

