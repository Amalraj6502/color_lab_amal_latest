        <record id="product_minibook" model="product.product">
            <field name="default_code">MINIBOOK10</field>
            <field name="name">Mini Book</field>
            <field name="is_storable" eval="True"/>
            <field name="lst_price">100.0</field>
            <field name="standard_price">70.0</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="image_1920" type="base64" file="color_lab_sale/static/img/minibook.jpg"/>
        </record>
        <record id="product_emboss" model="product.product">
            <field name="default_code">Emboss</field>
            <field name="name">Emboss</field>
            <field name="is_storable" eval="True"/>
            <field name="lst_price">0.0</field>
            <field name="standard_price">0</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
        </record>

