            <field name="step_count">2</field>
            <field name="previous_step" ref="color_lab_sale.cover_print_normal"/>
            <field name="name">Cover Lam</field>
            <field name="type">normal</field>
            <field name="section">3</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_cover_lam_users'))]"></field>

        </record>

        <record id="cover_finish_normal" model="work.category">
            <field name="step_count">1</field>
            <!--            <field name="previous_step"></field>-->
            <field name="is_common_step">true</field>
            <field name="common_step_ids"
                   eval="[Command.set([ref('color_lab_sale.cover_lam_normal'), ref('color_lab_sale.board_normal')])]"/>
            <field name="name">Cover Finish</field>
            <field name="type">normal</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_cover_finish_users'))]"></field>

        </record>

