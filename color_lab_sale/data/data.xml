        <record id="album_normal" model="work.category">
            <field name="step_count">0</field>
            <field name="is_common_step">true</field>
            <field name="name">Album</field>
            <field name="common_step_ids"
                   eval="[Command.set([ref('color_lab_sale.cake_normal'), ref('color_lab_sale.cover_finish_normal')])]"/>
            <field name="type">normal</field>
            <field name="group_ids" eval="[(4, ref('color_lab_sale.group_album_users'))]"></field>

        </record>

