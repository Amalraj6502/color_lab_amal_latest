<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="brand_tree">
            <field name="name">Brand</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <list string="Brand Tree">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="brand_form">
            <field name="name">product.brand.form</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <form string="Product Brand Form">
                    <sheet>
                        <field name="image_1920" widget='image' class="oe_avatar"/>
                        <div class="oe_title mb24">
                            <h1>
                                <field id="name" widget="text" class="text-break" name="name" default_focus="1"
                                       placeholder="e.g. HP or Canon.."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="code" required="1"/>
                            </group>
                        </group>
                        <label for="remarks"/>
                        <field name="remarks"/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="product_brand_menu_action" model="ir.actions.act_window">
            <field name="name">Product Brand</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.brand</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create The Product Brand</p>
            </field>
        </record>
        <menuitem id="product_brand" parent="color_lab_sale.configuration_main_custom_menu" name="Brand"
                  action="product_brand_menu_action"/>
    </data>
</odoo>