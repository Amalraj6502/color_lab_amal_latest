<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record model="ir.ui.view" id="courier_type_tree">
            <field name="name">courier.type.conf.tree</field>
            <field name="model">courier.type.conf</field>
            <field name="arch" type="xml">
                <list string="Courier Type Tree">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form View with Right-Side Chatter -->
        <record model="ir.ui.view" id="courier_type_form">
            <field name="name">courier.type.conf.form</field>
            <field name="model">courier.type.conf</field>
            <field name="arch" type="xml">
                <form string="Title Form">
                    <sheet>
                        <div class="col-8">
                            <group>
                                <field name="name" force_save="1" placeholder="Blue Dart,DHL etc..."/>
                            </group>
                        </div>

                        <div class="col-4">
                            <chatter/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="courier_type_conf_menu_action" model="ir.actions.act_window">
            <field name="name">Courier Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">courier.type.conf</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create New Courier Type</p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="courier_type_conf"
                  parent="color_lab_sale.configuration_main_custom_menu"
                  name="Courier Type"
                  action="courier_type_conf_menu_action"/>

    </data>
</odoo>
