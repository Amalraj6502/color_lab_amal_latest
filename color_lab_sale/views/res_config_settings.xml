<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_hr_contract_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hr.contract.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='connectors_setting_container']" position="after">
                <block title="EMBOSS CONFIGURATION" id="connectors_setting_container">
                    <setting id="EMBOSS RATE CONFIGURATION" help="EMBOSS RATE PER UNIT COST CONFIGURATION">
                        <field name="emboss_rate"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>