<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_product_form_inherit_color_lab" model="ir.ui.view">
            <field name="name">Product Inherit Colorlab</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='purchase_ok']" position="after">
                    <field name="is_addon_product"/>
                    <label for="is_addon_product"/>
                </xpath>
                <xpath expr="//field[@name='type']" position="before">
                    <field name="at_type"/>
                    <field name="is_variant" invisible="1"/>
                </xpath>
                <xpath expr="//label[@for='name']" position="before">
                    <label for="at_product_template_id"/>
                    <field name="at_product_template_id" required="1"
                           domain="[('is_product_template_category','=',True)]"/>
                    <br/>
                </xpath>
            </field>
        </record>

        <record id="product_template_form_inherit_color_lab" model="ir.ui.view">
            <field name="name">Product Template Inherit Colorlab</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="before">
                    <field name="at_type" required="1"/>
                    <field name="is_product_template_category" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="stock.stock_product_normal_action" model="ir.actions.act_window">
            <field name="name">Product Variants</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="search_view_id" ref="stock.stock_product_search_form_view"/>
            <field name="domain">[('is_variant','=',True)]</field>
            <field name="context">{'default_is_variant': True}</field>
        </record>

        <record id="stock.product_template_action_product" model="ir.actions.act_window">
            <field name="name">Product Template Category</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="stock.product_template_search_form_view_stock"/>
            <field name="domain">[('is_product_template_category','=',True)]</field>
            <field name="context">{"search_default_goods": 1, 'default_is_storable':
                True,'default_is_product_template_category': True}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No product found. Let's create one!
                </p>
                <p>
                    Track your stock quantities by creating storable products.
                </p>
            </field>
        </record>


    </data>
</odoo>
