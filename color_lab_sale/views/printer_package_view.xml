            <field name="name">Printer Repair</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">printer.package</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type','=','repair')]</field>
            <field name="context">{'default_type': 'repair'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create The First Printer Repair</p>
