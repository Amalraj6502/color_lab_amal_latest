        <record id="printer_reework_menu_action" model="ir.actions.act_window">
            <field name="name">Printer Reework</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">printer.package</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type','=','reework')]</field>
            <field name="context">{'default_type': 'reework'}</field>
            <field name="help" type="html">
