        <record id="printer_laser_menu_action" model="ir.actions.act_window">
            <field name="name">Printer laser</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">printer.package</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type','=','laser')]</field>
            <field name="context">{'default_type': 'laser'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create The First Printer Laser</p>
            </field>
        </record>

        <menuitem id="printer_service_menu" parent="color_lab_sale.configuration_main_custom_menu"
                  name="Printer Service types"/>

        <menuitem id="printer_package_menu" parent="color_lab_sale.printer_service_menu" name="Printer Packages"
                  action="printer_package_menu_action"/>

        <menuitem id="printer_photobook_menu" parent="color_lab_sale.printer_service_menu"
                  name="Printer Photobook"
                  action="printer_photobook_menu_action"/>

        <menuitem id="printer_print_menu" parent="color_lab_sale.printer_service_menu"
                  name="Printer Print"
                  action="printer_print_menu_action"/>

        <menuitem id="printer_repair_menu" parent="color_lab_sale.printer_service_menu"
                  name="Printer Repair"
                  action="printer_repair_menu_action"/>

        <menuitem id="printer_reework_menu" parent="color_lab_sale.printer_service_menu"
                  name="Printer Reework"
                  action="printer_reework_menu_action"/>

        <menuitem id="printer_laser_menu" parent="color_lab_sale.printer_service_menu"
                  name="Printer Laser"
                  action="printer_laser_menu_action"/>

    </data>
</odoo>