<odoo>
    <record id="view_correction_work_order_report_wizard" model="ir.ui.view">
        <field name="name">correction.work.order.report.wizard.form</field>
        <field name="model">correction.work.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Correction Work Order Report">
                <group >
                    <field name="user_ids" widget="many2many_tags"/>
                </group>
                <group>
                    <group>
                        <field name="start_date" string="As On"/>
                    </group>
                    <group>
                        <field name="end_date" string="End Date"/>
                        <field name="minibook_required" />
                    </group>
                </group>

                <footer>
                    <button name="action_print_report"
                            type="object"
                            string="Print PDF"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_correction_work_order_report_wizard" model="ir.actions.act_window">
        <field name="name">Correction Work Order Report</field>
        <field name="res_model">correction.work.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="correction_report_wizard" name="Correction Report Wizard" parent="sale.menu_sale_report"
              action="action_correction_work_order_report_wizard" sequence="7"/>
</odoo>
