<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_quotation_report_list_filter">
        <t t-call="web.html_container">
            <div class="page" style="position: relative;">
                <!-- Watermark -->
                <div style="
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%) rotate(-45deg);
                    font-size: 80px;
                    font-weight: bold;
                    color: rgba(0, 0, 0, 0.08);
                    z-index: 0;
                    pointer-events: none;
                    white-space: nowrap;
                ">Alukkas Colorlab LLP</div>

                <!-- Header -->
                <div style="text-align: center; margin-bottom: 30px;">
                    <h1>Quotations List</h1>
                </div>

                <!-- Single Table for All Records -->
                <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                    <thead>
                        <tr>
                            <th style="border: 1px solid #000; padding: 8px; background-color: #f8f9fa; text-align: left;">Number</th>
                            <th style="border: 1px solid #000; padding: 8px; background-color: #f8f9fa; text-align: left;">Customer</th>
                            <th style="border: 1px solid #000; padding: 8px; background-color: #f8f9fa; text-align: left;">Agent</th>
                            <th style="border: 1px solid #000; padding: 8px; background-color: #f8f9fa; text-align: left;">Approval Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="doc">
                            <td style="border: 1px solid #000; padding: 8px;"><span t-field="doc.name"/></td>
                            <td style="border: 1px solid #000; padding: 8px;"><span t-field="doc.partner_id.name"/></td>
                            <td style="border: 1px solid #000; padding: 8px;"><span t-field="doc.user_id.name"/></td>
                            <td style="border: 1px solid #000; padding: 8px;"><span t-field="doc.approval_state"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Summary -->
                <div style="margin-top: 20px; text-align: right;">
                    Total Records: <span t-esc="len(docs)"/>
                </div>
            </div>
        </t>
    </template>
</odoo>